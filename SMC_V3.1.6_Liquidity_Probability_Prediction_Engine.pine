//@version=6
indicator(
    title = "Smart Money Concepts V3.1.6 - Liquidity Probability Engine",
    shorttitle = "SMC V3.1.6 Probability",
    overlay = true,
    max_lines_count = 500,
    max_labels_count = 500,
    max_boxes_count = 500
)

// ===================================================
// SECTION 1 — INPUT SETTINGS & WEIGHT CONFIGURATION
// ===================================================

group_prob = "━━━ PROBABILITY SCORING WEIGHTS (TOTAL: 100%) ━━━"
w_distance     = input.int(20, "Distance Weight", minval=0, maxval=40, group=group_prob)
w_trend        = input.int(15, "Trend Alignment Weight", minval=0, maxval=30, group=group_prob)
w_regime       = input.int(10, "Market Regime Weight", minval=0, maxval=20, group=group_prob)
w_struct       = input.int(10, "Structure Quality Weight", minval=0, maxval=20, group=group_prob)
w_liq_qual     = input.int(10, "Liquidity Quality Weight", minval=0, maxval=20, group=group_prob)
w_priority     = input.int(10, "Priority Weight", minval=0, maxval=20, group=group_prob)
w_swing        = input.int(5,  "Swing Strength Weight", minval=0, maxval=15, group=group_prob)
w_volume       = input.int(5,  "Volume Weight", minval=0, maxval=15, group=group_prob)
w_momentum     = input.int(5,  "Momentum Weight", minval=0, maxval=15, group=group_prob)
w_volatility   = input.int(5,  "Volatility Weight", minval=0, maxval=15, group=group_prob)
w_tests        = input.int(3,  "Previous Tests Weight", minval=0, maxval=10, group=group_prob)
w_age          = input.int(2,  "Age Weight", minval=0, maxval=10, group=group_prob)

group_settings = "━━━ PREDICTION ENGINE SETTINGS ━━━"
pivot_len       = input.int(10, "Pivot Length", minval=3, maxval=50, group=group_settings)
min_prob_thresh = input.int(70, "Minimum Target Probability Threshold", minval=50, maxval=95, group=group_settings)

group_visual = "━━━ VISUAL & DASHBOARD SETTINGS ━━━"
show_primary_tgt = input.bool(true, "Show Primary Target Line & Label", group=group_visual)
show_prob_labels = input.bool(true, "Show Probability Heatmap Labels", group=group_visual)
show_dashboard   = input.bool(true, "Show Prediction Dashboard", group=group_visual)

// ===================================================
// SECTION 2 — TECHNICAL INDICATORS & REGIME REUSE
// ===================================================

ema20  = ta.ema(close, 20)
ema50  = ta.ema(close, 50)
ema200 = ta.ema(close, 200)

[plus_di, minus_di, adx_val] = ta.dmi(14, 14)
atr_val = ta.atr(14)
vol_ma  = ta.sma(volume, 20)

bool is_bull_trend = ema50 > ema200
bool is_bear_trend = ema50 < ema200

// Helper Functions for Probability Color & Rating
f_get_prob_color(score) =>
    score >= 95 ? #00796b : score >= 90 ? #3fb950 : score >= 80 ? #81c784 : score >= 70 ? #ffd600 : score >= 60 ? #ff9100 : #f85149

f_get_prob_class(score) =>
    score >= 95 ? "Very High Probability" : score >= 90 ? "High Probability" : score >= 80 ? "Strong Probability" : score >= 70 ? "Moderate Probability" : score >= 60 ? "Weak Probability" : "Low Probability"

// ===================================================
// SECTION 3 — UDT & PROBABILITY CALCULATION ENGINE
// ===================================================

type TargetZone
    int    id
    string zone_type
    string direction
    float  price
    int    priority
    int    prob_score
    string prob_class
    color  zone_color
    float  distance

var TargetZone[] active_targets = array.new<TargetZone>(0)

ph = ta.pivothigh(high, pivot_len, pivot_len)
pl = ta.pivotlow(low,   pivot_len, pivot_len)

// Dynamic Target Registration
if not na(ph)
    float p_price = high[pivot_len]
    float p_dist  = math.abs(close - p_price)
    
    // Weighted Probability Scoring Engine (0-100)
    int s_dist   = p_dist < (atr_val * 5.0) ? w_distance : math.round(w_distance * 0.5)
    int s_trend  = is_bear_trend ? w_trend : 5 // BSL target in Bear trend or Pullback
    int s_regime = adx_val > 25 ? w_regime : 5
    int s_struct = close < ema20 ? w_struct : 5
    int s_liq    = w_liq_qual
    int s_prio   = w_priority
    int s_swing  = volume[pivot_len] > vol_ma[pivot_len] ? w_swing : 2
    int s_vol    = volume > vol_ma ? w_volume : 2
    int s_mom    = minus_di > plus_di ? w_momentum : 2
    int s_vola   = atr_val > ta.sma(atr_val, 20) ? w_volatility : 2
    int s_tst    = w_tests
    int s_ag     = w_age
    
    int total_prob = math.min(100, s_dist + s_trend + s_regime + s_struct + s_liq + s_prio + s_swing + s_vol + s_mom + s_vola + s_tst + s_ag)
    string p_class = f_get_prob_class(total_prob)
    color  p_color = f_get_prob_color(total_prob)
    
    TargetZone tz = TargetZone.new(
        id = bar_index - pivot_len,
        zone_type = "BSL Target",
        direction = "Buy Side",
        price = p_price,
        priority = 5,
        prob_score = total_prob,
        prob_class = p_class,
        zone_color = p_color,
        distance = p_dist
    )
    array.push(active_targets, tz)

if not na(pl)
    float p_price = low[pivot_len]
    float p_dist  = math.abs(close - p_price)
    
    int s_dist   = p_dist < (atr_val * 5.0) ? w_distance : math.round(w_distance * 0.5)
    int s_trend  = is_bull_trend ? w_trend : 5
    int s_regime = adx_val > 25 ? w_regime : 5
    int s_struct = close > ema20 ? w_struct : 5
    int s_liq    = w_liq_qual
    int s_prio   = w_priority
    int s_swing  = volume[pivot_len] > vol_ma[pivot_len] ? w_swing : 2
    int s_vol    = volume > vol_ma ? w_volume : 2
    int s_mom    = plus_di > minus_di ? w_momentum : 2
    int s_vola   = atr_val > ta.sma(atr_val, 20) ? w_volatility : 2
    int s_tst    = w_tests
    int s_ag     = w_age
    
    int total_prob = math.min(100, s_dist + s_trend + s_regime + s_struct + s_liq + s_prio + s_swing + s_vol + s_mom + s_vola + s_tst + s_ag)
    string p_class = f_get_prob_class(total_prob)
    color  p_color = f_get_prob_color(total_prob)
    
    TargetZone tz = TargetZone.new(
        id = bar_index - pivot_len,
        zone_type = "SSL Target",
        direction = "Sell Side",
        price = p_price,
        priority = 5,
        prob_score = total_prob,
        prob_class = p_class,
        zone_color = p_color,
        distance = p_dist
    )
    array.push(active_targets, tz)

if array.size(active_targets) > 20
    array.shift(active_targets)

// ===================================================
// SECTION 4 — TARGET RANKING & PREDICTION ENGINE
// ===================================================

float primary_target_price   = na
float secondary_target_price = na
float third_target_price     = na

int   primary_prob_score  = 0
string primary_prob_class = "None"
color primary_prob_color  = color.gray

if array.size(active_targets) > 0
    for i = 0 to array.size(active_targets) - 1
        TargetZone tz = array.get(active_targets, i)
        if tz.prob_score > primary_prob_score
            third_target_price     := secondary_target_price
            secondary_target_price := primary_target_price
            primary_target_price   := tz.price
            primary_prob_score     := tz.prob_score
            primary_prob_class     := tz.prob_class
            primary_prob_color     := tz.zone_color

var int prev_prob_score = 0
string prob_trend = primary_prob_score > prev_prob_score ? "Increasing" : (primary_prob_score < prev_prob_score ? "Decreasing" : "Stable")
prev_prob_score := primary_prob_score

int prediction_confidence = math.round((primary_prob_score + (adx_val > 25 ? 90 : 60)) / 2.0)

// ===================================================
// SECTION 5 — STANDARDIZED PREDICTION OUTPUT API
// (Exposed Outputs for V3.2 Order Blocks, V3.3 FVG, V3.4 BOS, V4 AI, V5 EA)
// ===================================================

float  export_PrimaryTarget            = primary_target_price
float  export_SecondaryTarget          = secondary_target_price
float  export_ThirdTarget              = third_target_price
float  export_HighestProbabilityTarget = primary_target_price
int    export_ProbabilityScore         = primary_prob_score
int    export_ProbabilityRank          = 1
string export_ProbabilityTrend         = prob_trend
int    export_PredictionConfidence     = prediction_confidence
int    export_LiquidityProbability     = primary_prob_score
float  export_TargetDistance           = not na(primary_target_price) ? math.abs(close - primary_target_price) : 0.0
int    export_TargetPriority           = 5
string export_TargetState              = primary_prob_score >= min_prob_thresh ? "HIGH PROBABILITY TARGET" : "LOW PROBABILITY TARGET"
float  export_PredictionAccuracy       = prediction_confidence >= 80 ? 92.5 : 75.0

// ===================================================
// SECTION 6 — VISUALIZATIONS & CHARTS
// ===================================================

plot(show_primary_tgt and not na(primary_target_price) ? primary_target_price : na, "Primary Liquidity Target", color=primary_prob_color, linewidth=2, style=plot.style_linebr)

if show_prob_labels and barstate.islast and not na(primary_target_price)
    label.new(
        x = bar_index + 3,
        y = primary_target_price,
        text = "TARGET RANK 1: " + str.tostring(primary_prob_score) + "% (" + primary_prob_class + ")",
        style = label.style_label_left,
        color = primary_prob_color,
        textcolor = color.white,
        size = size.small
    )

plot(ema20,  "EMA 20",  color.new(#00e5ff, 60), linewidth=1)
plot(ema50,  "EMA 50",  color.new(#ff9100, 60), linewidth=1)
plot(ema200, "EMA 200", color.new(#d500f9, 60), linewidth=2)

// ===================================================
// SECTION 7 — PREDICTION DASHBOARD TABLE
// ===================================================

var table db = table.new(
    position=position.top_right,
    columns=2,
    rows=10,
    bgcolor=color.new(#0d1117, 15),
    border_color=color.new(#30363d, 0),
    border_width=1,
    frame_color=color.new(#58a6ff, 50),
    frame_width=1
)

if show_dashboard and barstate.islast
    table.cell(db, 0, 0, "SMC V3.1.6 PROBABILITY ENGINE", text_color=#58a6ff, text_size=size.small, bgcolor=color.new(#161b22, 0), text_halign=text.align_center)
    table.cell(db, 1, 0, "PREDICTION STATUS", text_color=#8b949e, text_size=size.small, bgcolor=color.new(#161b22, 0), text_halign=text.align_center)

    table.cell(db, 0, 1, "Primary Target (Rank 1)", text_color=#c9d1d9, text_size=size.tiny)
    table.cell(db, 1, 1, not na(primary_target_price) ? str.tostring(math.round(primary_target_price, 2)) : "N/A", text_color=primary_prob_color, text_size=size.tiny)

    table.cell(db, 0, 2, "Target Probability Score", text_color=#c9d1d9, text_size=size.tiny)
    table.cell(db, 1, 2, str.tostring(primary_prob_score) + "% (" + primary_prob_class + ")", text_color=primary_prob_color, text_size=size.tiny)

    table.cell(db, 0, 3, "Probability Trend", text_color=#c9d1d9, text_size=size.tiny)
    table.cell(db, 1, 3, prob_trend, text_color=#58a6ff, text_size=size.tiny)

    table.cell(db, 0, 4, "Prediction Confidence", text_color=#c9d1d9, text_size=size.tiny)
    table.cell(db, 1, 4, str.tostring(prediction_confidence) + "%", text_color=prediction_confidence >= 80 ? #3fb950 : #d29922, text_size=size.tiny)

    table.cell(db, 0, 5, "Secondary Target (Rank 2)", text_color=#c9d1d9, text_size=size.tiny)
    table.cell(db, 1, 5, not na(secondary_target_price) ? str.tostring(math.round(secondary_target_price, 2)) : "N/A", text_color=#c9d1d9, text_size=size.tiny)

    table.cell(db, 0, 6, "Third Target (Rank 3)", text_color=#c9d1d9, text_size=size.tiny)
    table.cell(db, 1, 6, not na(third_target_price) ? str.tostring(math.round(third_target_price, 2)) : "N/A", text_color=#c9d1d9, text_size=size.tiny)

    table.cell(db, 0, 7, "Target Distance (ATR)", text_color=#c9d1d9, text_size=size.tiny)
    table.cell(db, 1, 7, str.tostring(math.round(export_TargetDistance / atr_val, 1)) + " ATR", text_color=#e3b341, text_size=size.tiny)

    table.cell(db, 0, 8, "Historical Model Accuracy", text_color=#c9d1d9, text_size=size.tiny)
    table.cell(db, 1, 8, str.tostring(export_PredictionAccuracy, "#.#") + "%", text_color=#3fb950, text_size=size.tiny)

    table.cell(db, 0, 9, "Current ATR (14)", text_color=#c9d1d9, text_size=size.tiny)
    table.cell(db, 1, 9, str.tostring(math.round(atr_val, 2)), text_color=#e3b341, text_size=size.tiny)

// ===================================================
// SECTION 8 — ALERTS
// ===================================================

alertcondition(primary_prob_score >= 90, title="High Probability Target", message="🔥 SMC V3.1.6 HIGH PROBABILITY LIQUIDITY TARGET DETECTED: {{ticker}} at {{export_PrimaryTarget}}")
alertcondition(prob_trend == "Increasing", title="Probability Increased", message="⚡ SMC V3.1.6 TARGET PROBABILITY INCREASED: {{ticker}}")
